# Copy to .env to override defaults in backend/app/config.py (prefix HAKI_, case-insensitive).
# HAKI_OLLAMA_URL=http://localhost:11434
# HAKI_OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
# HAKI_NUM_CTX=8192
# HAKI_NUM_PREDICT=1500
# HAKI_RELEVANCE_THRESHOLD=0.0
# HAKI_MAX_QUESTION_CHARS=1000
# HAKI_RATE_LIMIT_PER_MIN=10
# HAKI_LOG_CONTENT=false
# HAKI_API_PORT=8000
